{
  "name": "@default/types",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./user": {
      "types": "./src/user/index.ts",
      "require": "./dist/user/index.js",
      "import": "./dist/user/index.js",
      "default": "./dist/user/index.js"
    },
    "./role": {
      "types": "./src/role/index.ts",
      "require": "./dist/role/index.js",
      "import": "./dist/role/index.js",
      "default": "./dist/role/index.js"
    },
    "./permission": {
      "types": "./src/permission/index.ts",
      "require": "./dist/permission/index.js",
      "import": "./dist/permission/index.js",
      "default": "./dist/permission/index.js"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "require": "./dist/auth/index.js",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./common": {
      "types": "./src/common/index.ts",
      "require": "./dist/common/index.js",
      "import": "./dist/common/index.js",
      "default": "./dist/common/index.js"
    },
    "./site-settings": {
      "types": "./src/site-settings/index.ts",
      "require": "./dist/site-settings/index.js",
      "import": "./dist/site-settings/index.js",
      "default": "./dist/site-settings/index.js"
    },
    "./dashboard": {
      "types": "./src/dashboard/index.ts",
      "require": "./dist/dashboard/index.js",
      "import": "./dist/dashboard/index.js",
      "default": "./dist/dashboard/index.js"
    },
    "./audit-log": {
      "types": "./src/audit-log/index.ts",
      "require": "./dist/audit-log/index.js",
      "import": "./dist/audit-log/index.js",
      "default": "./dist/audit-log/index.js"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "require": "./dist/media/index.js",
      "import": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "user": ["./src/user/index.ts"],
      "role": ["./src/role/index.ts"],
      "permission": ["./src/permission/index.ts"],
      "auth": ["./src/auth/index.ts"],
      "common": ["./src/common/index.ts"],
      "site-settings": ["./src/site-settings/index.ts"],
      "dashboard": ["./src/dashboard/index.ts"],
      "audit-log": ["./src/audit-log/index.ts"],
      "media": ["./src/media/index.ts"]
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@default/tsconfig": "workspace:*",
    "typescript": "^5.9.2"
  }
}
