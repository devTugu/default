{
  "realm": "website",
  "enabled": true,
  "users": [
    {
      "username": "oauth-user",
      "email": "oauth-user@example.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "OAuth123!",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
